# vision-service/.env.example
# The Modal container reads these vars when running locally (modal serve).
# Production deploys (modal deploy) read from Modal Secrets — set the same vars
# via:
#   modal secret create aurel-iris-vision \
#     MODAL_WEBHOOK_SECRET=$(openssl rand -hex 32) \
#     WEBHOOK_BASE_URL=https://aurel-iris.vercel.app
# and ensure modal_app.py decorates the function with `secrets=[modal.Secret.from_name("aurel-iris-vision")]`.

# Shared HMAC secret. MUST match apps/web/.env MODAL_WEBHOOK_SECRET exactly.
# Used by _post_webhook to sign the callback body (Stripe-style timestamp.body convention).
# Generate once with: openssl rand -hex 32
MODAL_WEBHOOK_SECRET=

# Base URL of the deployed Next.js app (no trailing slash). The Modal worker
# POSTs back to {WEBHOOK_BASE_URL}/api/vision/webhook with the HMAC signature.
# Production: https://aurel-iris.vercel.app
# Preview:    https://aurel-iris-<branch>-<account>.vercel.app
WEBHOOK_BASE_URL=
