# .env.example
# Template de variáveis de ambiente para Aurel Iris.
# Copie para .env.local (gitignored) e preencha. Em Vercel, cadastre via Dashboard
# -> Settings -> Environment Variables, separadas por ambiente (Production / Preview / Development).
# Vide PROJECT.md "Restrições" e CONTEXT.md D-10/D-11.

# ============================================================
# SUPABASE (Phase 1 Setup — usado já)
# ============================================================
# Project URL: Dashboard -> Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key: Dashboard -> Settings -> API -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: Dashboard -> Settings -> API -> service_role
# NUNCA expor no client. Usar apenas em Route Handlers / scripts server-side.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# ANTHROPIC (Phase 7 — Análise LLM)
# ============================================================
# Console: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ============================================================
# VOYAGE AI (Phase 6 — RAG Embeddings)
# ============================================================
# Dashboard: https://dash.voyageai.com/api-keys
VOYAGE_API_KEY=

# ============================================================
# MODAL (Phase 5 — Pipeline de Visão)
# ============================================================
# Settings: https://modal.com/settings/tokens
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# HMAC secret usado pelo webhook do Modal -> /api/vision/webhook
# Gerar com: openssl rand -hex 32
MODAL_WEBHOOK_SECRET=

# ============================================================
# STRIPE (Phase 8 — Pagamento + LGPD)
# ============================================================
# Dashboard Brazil: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Webhook signing secret (Stripe Dashboard -> Webhooks -> endpoint -> Signing secret)
STRIPE_WEBHOOK_SECRET=

# ============================================================
# RESEND (Phase 9 — E-mail transacional)
# ============================================================
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=
