# apps/web/.env.local.example
# Copie para apps/web/.env.local para desenvolvimento local do Next.js.
# Next.js carrega .env.local automaticamente (já em .gitignore).
# Para produção, cadastre em Vercel Dashboard -> Settings -> Environment Variables.

# Supabase (Phase 1+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Phase 7+)
ANTHROPIC_API_KEY=

# Voyage AI (Phase 6+)
VOYAGE_API_KEY=

# Modal (Phase 5+)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_WEBHOOK_SECRET=

# Stripe (Phase 8+)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (Phase 9+)
RESEND_API_KEY=
