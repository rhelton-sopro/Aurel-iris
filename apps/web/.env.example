# apps/web/.env.example
# Variáveis de ambiente para o Next.js (apps/web/).
# Copie para apps/web/.env.local para desenvolvimento local.
# Em Vercel, cadastre via Dashboard -> Settings -> Environment Variables.

# Supabase (Phase 1+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Phase 7+)
ANTHROPIC_API_KEY=

# Voyage AI (Phase 6+)
VOYAGE_API_KEY=

# Modal (Phase 5+)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_WEBHOOK_SECRET=

# Stripe (Phase 8+)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (Phase 9+)
RESEND_API_KEY=

# Site URL (usado em emailRedirectTo do magic link)
# Produção: https://aurel-iris-web.vercel.app
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://aurel-iris-web.vercel.app
