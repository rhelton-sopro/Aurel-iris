{
  "name": "aurel-iris",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "type-check": "pnpm --filter web exec tsc --noEmit",
    "rag:ingest": "cd vision-service && python -m scripts.ingest_knowledge",
    "rag:purge": "cd vision-service && python -m scripts.ingest_knowledge --purge",
    "rag:spot-check": "curl -fsS -H \"x-spot-check-token: ${RAG_SPOT_CHECK_TOKEN}\" http://localhost:3000/api/admin/rag-spot-check",
    "audit:vocabulary:db": "node apps/web/scripts/audit-vocabulary-db.mjs"
  },
  "devDependencies": {
    "pg": "^8.20.0"
  }
}
